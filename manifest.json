<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DSM Takip Sistemi</title>
    <link rel="manifest" href="manifest.json">
    <style>
        :root {
            /* Bauer Tarzı Renk Paleti */
            --bauer-blue: #003366; /* Koyu Endüstriyel Mavi */
            --bauer-yellow: #FFD700; /* Parlak Bauer Sarısı */
            --bg-dark: #0A0C10;
            --card-bg: #161B22;
            --text-light: #F0F6FC;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        /* Logo ve Başlık Alanı */
        header {
            width: 100%;
            background-color: var(--bauer-blue);
            padding: 30px 0; /* Logo sığması için dikey padding artırıldı */
            text-align: center;
            border-bottom: 4px solid var(--bauer-yellow);
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Yenilenmiş Tam Aydın Mühendislik Logosu (SVG) */
        /* Orijinal görseldeki tüm detayları içerir */
        .aj-logo {
            width: 180px; /* Detaylar için genişletildi */
            height: auto;
            fill: var(--bauer-yellow);
            display: block;
            margin: 0 auto 15px auto;
        }

        h1 {
            color: var(--bauer-yellow);
            font-size: 1.4rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin: 10px 0 5px 0;
        }

        .company-subtext {
            font-size: 0.7rem;
            font-weight: bold;
            color: white;
            opacity: 0.9;
        }

        /* Dashboard Kartları */
        .container {
            width: 90%;
            max-width: 500px;
            margin-top: 30px;
        }

        .card {
            background-color: var(--card-bg);
            border-left: 5px solid var(--bauer-yellow);
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-info h2 {
            margin: 0;
            font-size: 0.9rem;
            color: #8B949E;
        }

        .card-info p {
            margin: 5px 0 0 0;
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--bauer-yellow);
        }

        .btn-action {
            background-color: var(--bauer-yellow);
            color: var(--bauer-blue);
            border: none;
            padding: 15px 30px;
            border-radius: 5px;
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
            width: 100%;
            text-transform: uppercase;
            transition: transform 0.2s;
        }

        .btn-action:active {
            transform: scale(0.98);
        }
    </style>
</head>
<body>

<header>
    <svg class="aj-logo" viewBox="0 0 400 300">
        <g stroke="currentColor" stroke-width="6" fill="none">
            <path d="M100 50 L100 250"/> <path d="M90 60 L100 50 L110 60"/> <path d="M100 210 L80 230 L120 230 Z"/> <path d="M100 230 L100 270"/> <path d="M90 270 L110 270"/> </g>
        
        <circle cx="210" cy="110" r="80" fill="none" stroke="currentColor" stroke-width="8"/>
        <text x="210" y="140" font-family="Verdana, Geneva, sans-serif" font-size="80" font-weight="bold" text-anchor="middle" letter-spacing="-5">AJ</text>
        
        <g stroke="currentColor" stroke-width="6" fill="none">
            <path d="M220 180 L280 180 L280 230 L220 230 Z"/>
            <path d="M225 185 L260 185 L260 210 L225 210 Z"/> <path d="M200 230 L300 230 L320 250 L200 250 Z"/>
            <path d="M200 250 L180 270 L340 270 L320 250 Z" fill="currentColor"/>
            
            <path d="M100 130 L160 210" stroke-width="4"/>
            <path d="M100 170 L160 220" stroke-width="4"/>
        </g>
    </svg>
    
    <h1>AYDIN JEOTEKNİK</h1>
    <div class="company-subtext">MÜHENDİSLİK TİC. LTD. ŞTİ.</div>
</header>

<div class="container">
    <div class="card">
        <div class="card-info">
            <h2>GÜNLÜK KUYU SAYISI</h2>
            <p id="well-count">12</p>
        </div>
        <svg width="40" height="40" viewBox="0 0 24 24" fill="var(--bauer-yellow)">
            <path d="M13,14H11V10H13M13,18H11V16H13M19,13H17V7H5V13H3V5H19V13Z" />
        </svg>
    </div>

    <div class="card">
        <div class="card-info">
            <h2>TOPLAM DERİNLİK (m)</h2>
            <p id="total-depth">180.5</p>
        </div>
        <svg width="40" height="40" viewBox="0 0 24 24" fill="var(--bauer-yellow)">
            <path d="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" />
        </svg>
    </div>

    <button class="btn-action">YENİ VERİ GİRİŞİ</button>
</div>

<script>
    // PWA Service Worker Kaydı (Manifest dosyasının çalışması için gereklidir)
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').then(reg => {
                console.log('SW Kayıtlı', reg);
            }).catch(err => {
                console.log('SW Hatası', err);
            });
        });
    }
</script>

</body>
</html>
